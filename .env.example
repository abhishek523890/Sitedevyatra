# =====================================================================
# DevYatra India - Environment Variables
# Copy this file to ".env.local" and fill in real values.
# NEVER commit .env.local. NEVER expose service-role or secret keys to the browser.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the client.
# =====================================================================

# ---- Supabase (free tier) -------------------------------------------
# Dashboard: https://app.supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Full DB access, bypasses RLS. Used ONLY in server code / webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- Email provider (modular) ---------------------------------------
# Default adapter = Resend (free 3,000 emails/month). Swap provider in src/lib/email.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your-resend-or-brevo-api-key
EMAIL_FROM_ADDRESS="DevYatra India <bookings@your-domain.com>"
OWNER_NOTIFICATION_EMAIL=owner@your-domain.com

# ---- Site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=+919000000000

# ---- Payments (placeholders - integrate later) ----------------------
# The app ships with "Pay Later / Request Confirmation" + manual admin recording.
PAYMENT_PROVIDER=none
PAYMENT_PROVIDER_KEY=your-razorpay-or-stripe-key
PAYMENT_PROVIDER_SECRET=your-payment-secret
PAYMENT_WEBHOOK_SECRET=your-webhook-signing-secret

# ---- Security --------------------------------------------------------
# Optional CAPTCHA (hCaptcha / Cloudflare Turnstile). Forms are CAPTCHA-ready.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
